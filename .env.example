# Copy to .env and fill in real values.  Never commit .env to version control.

# App environment. In development, the API can run without SIGNALEX_API_KEY.
# In production, set APP_ENV=production and provide SIGNALEX_API_KEY.
APP_ENV=development
SIGNALEX_API_KEY=

# Food AI enrichment is disabled by default; no AI provider key is required
# for the Food pipeline when this is false.
FOOD_AI_ENRICHMENT_ENABLED=false
AI_PROVIDER=none
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional OpenAI assistance for POST /api/food/claim-review.
# Disabled by default; deterministic rules remain the default source of truth.
FOOD_CLAIM_REVIEW_AI_ENABLED=false
OPENAI_CLAIM_MODEL=gpt-5.4-mini
FOOD_CLAIM_REVIEW_AI_MAX_DAILY=25
FOOD_CLAIM_REVIEW_AI_MAX_PER_IP_DAILY=3
FOOD_CLAIM_REVIEW_AI_MAX_INPUT_CHARS=1000
FOOD_CLAIM_REVIEW_AI_CACHE_ENABLED=true

# Comma-separated browser origins allowed by CORS.
# Development automatically includes localhost:3000/:5173 and 127.0.0.1:3000/:5173.
# Production uses only the origins explicitly listed here.
CORS_ORIGINS=https://signalex.com.au,https://www.signalex.com.au

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your@email.com
EMAIL_RECIPIENTS=recipient1@example.com,recipient2@example.com

# Slack webhook URL for real-time alert notifications.
# Create at: https://api.slack.com/messaging/webhooks
# Leave blank to disable Slack delivery.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXX/YYYY/ZZZZ
